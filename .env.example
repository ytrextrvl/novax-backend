APP_NAME="NOVAX TRAVEL API"
APP_ENV=production
APP_KEY=base64:CHANGE_ME
APP_DEBUG=false
APP_URL=https://api.novaxtravel.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSLMODE=require

JWT_SECRET=CHANGE_ME
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# Travel provider mode
# Keep manual until a provider API is approved. Switching later does not change the booking request contract.
TRAVEL_PROVIDER=manual
TRAVELPAYOUTS_ENABLED=false
TRAVELPAYOUTS_API_TOKEN=
TRAVELPAYOUTS_MARKER=

# Comma-separated list
CORS_ALLOWED_ORIGINS=https://novaxtravel.com,https://www.novaxtravel.com,https://admin.novaxtravel.com

# File uploads
FILESYSTEM_DISK=local

# Mail (wire a transactional provider before customer email notifications are enabled)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@novaxtravel.com
MAIL_FROM_NAME="NOVAX Travel"
